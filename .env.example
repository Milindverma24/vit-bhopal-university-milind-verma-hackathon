# RiskPulse AI - Configuration Template
# All features operate deterministically out-of-the-box in offline/synthetic mode without API keys.

DATABASE_URL=sqlite:///./riskpulse.db
FRONTEND_ORIGIN=http://localhost:5173
ENABLE_EXTERNAL_NEWS=false
ENABLE_PRETRAINED_NLP=false
NEWSAPI_KEY=
FINNHUB_API_KEY=

# Quantitative Rebalancing Parameters
ALPHA=0.45
BETA=0.65
MIN_WEIGHT=0.02
MAX_WEIGHT=0.20
MAX_TURNOVER=0.25
CONFIDENCE_THRESHOLD=0.55
